<Window x:Class="KeycodeAutomata.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Keycode Automata" Height="450" Width="660"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="#D4D0C8">

    <!-- Windows 2000 Outer Window Frame -->
    <Border BorderThickness="2,2,2,2" Background="#D4D0C8">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFFFFF" Offset="0.0"/>
                <GradientStop Color="#404040" Offset="1.0"/>
            </LinearGradientBrush>
        </Border.BorderBrush>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="22"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="22"/>
            </Grid.RowDefinitions>

            <!-- 1. Classic Windows 2000 Title Bar -->
            <Grid Grid.Row="0" MouseDown="TitleBar_MouseDown">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#000080" Offset="0.0"/>
                        <GradientStop Color="#1084D0" Offset="1.0"/>
                    </LinearGradientBrush>
                </Grid.Background>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                    <TextBlock Text="🔑" FontSize="11" Foreground="#FFFFFF" Margin="0,0,4,0"/>
                    <TextBlock Text="Keycode Automata Security System" FontFamily="Tahoma" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Window Control Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,2,2">
                    <!-- Minimize Button -->
                    <Button Click="MinimizeButton_Click" Width="16" Height="14" Margin="0,0,2,0" Background="#D4D0C8" FontFamily="Tahoma" FontWeight="Bold" Content="_" Padding="0,-6.6,0,0"/>
                    <!-- Close Button -->
                    <Button Click="CloseButton_Click" Width="16" Height="14" Background="#D4D0C8" FontSize="10" FontWeight="Bold" Content="r" FontFamily="Marlett" Padding="0,1,0,0" VerticalAlignment="Center" HorizontalAlignment="Center" RenderTransformOrigin="0.495,0.875"/>
                </StackPanel>
            </Grid>

            <!-- 2. Classic Menu Bar -->
            <Menu Grid.Row="1" Background="#D4D0C8" FontFamily="Tahoma" FontSize="11" VerticalAlignment="Center" Margin="2,0,0,0">
                <MenuItem Header="_File">
                    <MenuItem Header="_Exit" Click="CloseButton_Click"/>
                </MenuItem>
                <MenuItem Header="_Edit"/>
                <MenuItem Header="_View"/>
                <MenuItem Header="_Tools"/>
                <MenuItem Header="_Help"/>
            </Menu>

            <!-- 3. Main Content Area -->
            <Grid Grid.Row="2" Margin="8,8,8,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="270"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Panel: Win2k Control Panel Side Banner & Display -->
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <!-- Section Title Header -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                        <StackPanel VerticalAlignment="Center" Width="228">
                            <TextBlock Text="Keycode Panel" FontFamily="Tahoma" FontSize="22" FontWeight="Bold" Foreground="#000000" Width="169" Height="28" HorizontalAlignment="Left" Margin="0,20,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Divider Line -->
                    <Separator Background="#FF094BAD" Margin="0,0,0,12"/>

                    <!-- Sunken 3D LCD Display Box -->
                    <TextBlock Text="ENTER CODE:" FontFamily="Tahoma" FontSize="10" FontWeight="Bold" Foreground="#000000" Margin="14,0,0,4"/>
                    <Border BorderThickness="2,2,2,2" Background="#FFFFFF" Height="50" Margin="0,0,0,16" Width="234">

                        <TextBlock x:Name="txtDisplay" Text="----" FontFamily="Courier New" FontSize="32" FontWeight="Bold" Foreground="#000080" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Status Indicator Inset Box -->
                    <Border BorderThickness="2,2,2,2" Background="#D4D0C8" Padding="10,10,10,10" Width="233">

                        <StackPanel>
                            <TextBlock Text="SYSTEM STATUS" FontFamily="Tahoma" FontSize="10" FontWeight="Bold" Foreground="#808080" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="8*"/>
                                    <ColumnDefinition Width="9*"/>
                                    <ColumnDefinition Width="74*"/>
                                    <ColumnDefinition Width="118*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="CURRENT STATE:" FontFamily="Tahoma" FontSize="11" Grid.ColumnSpan="4" Margin="0,0,111,0" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="Response_Code" Text="Start" FontFamily="Tahoma" FontSize="11" Margin="20,0,0,0" Grid.Column="3" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right Panel: Classic Keypad Grid -->
                <UniformGrid Grid.Column="1" Rows="4" Columns="3">
                    <Button Content="1" FontFamily="Tahoma" FontSize="20" FontWeight="Bold" Margin="3,3,3,3" Background="#D4D0C8" Click="Button_Click"/>
                    <Button Content="2" FontFamily="Tahoma" FontSize="20" FontWeight="Bold" Margin="3,3,3,3" Background="#D4D0C8" Click="Button_Click"/>
                    <Button Content="3" FontFamily="Tahoma" FontSize="20" FontWeight="Bold" Margin="3,3,3,3" Background="#D4D0C8" Click="Button_Click"/>

                    <Button Content="4" FontFamily="Tahoma" FontSize="20" FontWeight="Bold" Margin="3,3,3,3" Background="#D4D0C8" Click="Button_Click"/>
                    <Button Content="5" FontFamily="Tahoma" FontSize="20" FontWeight="Bold" Margin="3,3,3,3" Background="#D4D0C8" Click="Button_Click"/>
                    <Button Content="6" FontFamily="Tahoma" FontSize="20" FontWeight="Bold" Margin="3,3,3,3" Background="#D4D0C8" Click="Button_Click"/>

                    <Button Content="7" FontFamily="Tahoma" FontSize="20" FontWeight="Bold" Margin="3,3,3,3" Background="#D4D0C8" Click="Button_Click"/>
                    <Button Content="8" FontFamily="Tahoma" FontSize="20" FontWeight="Bold" Margin="3,3,3,3" Background="#D4D0C8" Click="Button_Click"/>
                    <Button Content="9" FontFamily="Tahoma" FontSize="20" FontWeight="Bold" Margin="3,3,3,3" Background="#D4D0C8" Click="Button_Click"/>

                    <Button Content="X" FontFamily="Tahoma" FontSize="20" FontWeight="Bold" Foreground="#C00000" Margin="3,3,3,3" Background="#D4D0C8" Click="Button_Click"/>
                    <Button Content="0" FontFamily="Tahoma" FontSize="20" FontWeight="Bold" Margin="3,3,3,3" Background="#D4D0C8" Click="Button_Click"/>
                    <Button Content="&gt;" FontFamily="Tahoma" FontSize="20" FontWeight="Bold" Foreground="#0000C0" Margin="3,3,3,3" Background="#D4D0C8" Click="Button_Click"/>
                </UniformGrid>
            </Grid>

            <!-- 4. Windows 2000 Bottom Status Bar -->
            <StatusBar Grid.Row="3" Background="#D4D0C8" BorderThickness="0,1,0,0" BorderBrush="#808080" FontFamily="Tahoma" FontSize="11">
                <StatusBarItem x:Name="lblStatus" Content="Type code and press &gt; to submit. The correct code is 7158"/>
            </StatusBar>
        </Grid>
    </Border>
</Window>